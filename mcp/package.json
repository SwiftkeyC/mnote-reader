    "demo": "node sim/demo.js",
    "sim": "node sim/serve.js",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.3",
    "parse5": "^8.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
