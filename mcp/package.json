{
  "name": "mnote-mcp",
  "version": "1.0.0",
  "description": "MCP server for Mnote: your exported OneNote notes as tools, with a study coach that quizzes you from your own highlights",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "mnote-mcp": "src/server.js"
  },
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
